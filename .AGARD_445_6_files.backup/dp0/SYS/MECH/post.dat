/batch
/config,noeldb,1     ! force off writing results to database
*get,_wallstrt,active,,time,wall
*DIM,_wb_ProjectScratch_dir,string,248
_wb_ProjectScratch_dir(1) = 'C:\Users\aparr\Documents\ansys-digital-twin\_ProjectScratch\ScrDA53\'
*DIM,_wb_SolverFiles_dir,string,248
_wb_SolverFiles_dir(1) = 'C:\Users\aparr\Documents\ansys-digital-twin\AGARD_445_6_files\dp0\SYS\MECH\'
*DIM,_wb_userfiles_dir,string,248
_wb_userfiles_dir(1) = 'C:\Users\aparr\Documents\ansys-digital-twin\AGARD_445_6_files\user_files\'
! Executing MAPDL for /post1 evaluation of command objects only
_wb_post_run = 1
/post1
! ****** Begin Command Snippet ******
!   Commands inserted into this file will be executed immediately after the ANSYS /POST1 command.

!   Active UNIT system in Workbench when this object was created:  Metric (m, kg, N, s, V, A)
!   NOTE:  Any data that requires units (such as mass) is assumed to be in the consistent solver unit system.
!                See Solving Units in the help system for more information.


! ===========================================================
! Script APDL: Exportar frecuencias y modos a CSV
! ===========================================================
/POST1

! Crear y abrir el archivo de salida en el directorio de trabajo
*CFOPEN, modal_data, csv

! Escribir encabezado de las columnas
*VWRITE,'Mode','Freq_Hz','Force_UZ','Sens1_UZ','Sens2_UZ','Sens3_UZ'
(A6, A12, A14, A14, A14, A14)

! Obtener el número total de modos calculados
*GET, num_modes, ACTIVE, 0, SET, NSET

*DO, i, 1, num_modes
   ! Cargar la solución del modo i
   SET, 1, i
   *GET, freq, ACTIVE, 0, SET, FREQ

   ! Desplazamiento en Z en el nodo de entrada de fuerza
   CMSEL, S, Force_Input
   *GET, node_in, NODE, 0, NUM, MIN
   *GET, uz_in, NODE, node_in, U, Z

   ! Desplazamiento en Z en Sensor 1
   CMSEL, S, Sensor_1
   *GET, node_s1, NODE, 0, NUM, MIN
   *GET, uz_s1, NODE, node_s1, U, Z

   ! Desplazamiento en Z en Sensor 2
   CMSEL, S, Sensor_2
   *GET, node_s2, NODE, 0, NUM, MIN
   *GET, uz_s2, NODE, node_s2, U, Z

   ! Desplazamiento en Z en Sensor 3
   CMSEL, S, Sensor_3
   *GET, node_s3, NODE, 0, NUM, MIN
   *GET, uz_s3, NODE, node_s3, U, Z

   ALLSEL, ALL

   ! Escribir datos del modo actual
   *VWRITE, i, freq, uz_in, uz_s1, uz_s2, uz_s3
   (F6.0, ',', F12.4, ',', E14.6, ',', E14.6, ',', E14.6, ',', E14.6)

*ENDDO

*CFCLOSE

! ****** End   Command Snippet ******
xmlo,ENCODING,ISO-8859-1
xmlo,parm
/xml,parm,xml
fini
/gopr
*get,_walldone,active,,time,wall
_totaltim=(_walldone-_wallstrt)*3600
*get,_dlbratio,active,0,solu,dlbr
*get,_combtime,active,0,solu,comb
*get,_ssmode,active,0,solu,ssmm
*get,_ndofs,active,0,solu,ndof
/fclean				!clean distributed files
/com,--- Total number of nodes = %_numnode%
/com,--- Total number of elements = %_numelem%
/com,--- Element load balance ratio = %_dlbratio%
/com,--- Time to combine distributed files = %_combtime%
/com,--- Sparse memory mode = %_ssmode%
/com,--- Number of DOF = %_ndofs%
/wb,file,end               ! done with WB generated input
