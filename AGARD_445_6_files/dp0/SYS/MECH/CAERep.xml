! ===========================================================
! Script APDL: Exportar frecuencias, modos UZ y esfuerzo modal SEQV
! ===========================================================
/POST1
*CFOPEN,modal_data_with_stress,csv

*VWRITE,'Mode','Freq_Hz','Force_UZ','Sens1_UZ','Sens2_UZ','Sens3_UZ','Root_SEQV'
(A6, A12, A14, A14, A14, A14, A14)

*GET, num_modes, ACTIVE, 0, SET, NSET

*DO, i, 1, num_modes
   SET, 1, i
   *GET, freq, ACTIVE, 0, SET, FREQ

   CMSEL, S, Force_Input
   *GET, node_in, NODE, 0, NUM, MIN
   *GET, uz_in, NODE, node_in, U, Z

   CMSEL, S, Sensor_1
   *GET, node_s1, NODE, 0, NUM, MIN
