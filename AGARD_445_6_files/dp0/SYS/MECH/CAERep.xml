   *GET, uz_s2, NODE, node_s2, U, Z

   CMSEL, S, Sensor_3
   *GET, node_s3, NODE, 0, NUM, MIN
   *GET, uz_s3, NODE, node_s3, U, Z

   CMSEL, S, Root_Stress_Node
   *GET, node_root, NODE, 0, NUM, MIN
   *GET, seqv_root, NODE, node_root, S, EQV

   ALLSEL, ALL

   *VWRITE, i, freq, uz_in, uz_s1, uz_s2, uz_s3, seqv_root
(F6.0, ',', F12.4, ',', E14.6, ',', E14.6, ',', E14.6, ',', E14.6, ',', E14.6)
*ENDDO

*CFCLOSE
